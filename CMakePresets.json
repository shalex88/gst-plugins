{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "displayName": "Root Base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-base",
      "hidden": true,
      "inherits": "base",
      "displayName": "Root Native"
    },
    {
      "name": "native-debug",
      "displayName": "Root Native Debug",
      "inherits": "native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SUPERBUILD_PRESET": "native-debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Root Native Release",
      "inherits": "native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUPERBUILD_PRESET": "native-release"
      }
    },
    {
      "name": "cross-base",
      "hidden": true,
      "inherits": "base",
      "displayName": "Root Cross",
      "toolchainFile": "$env{CMAKE_TOOLCHAIN_FILE}"
    },
    {
      "name": "cross-debug",
      "displayName": "Root Cross Debug",
      "inherits": "cross-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SUPERBUILD_PRESET": "cross-debug"
      }
    },
    {
      "name": "cross-release",
      "displayName": "Root Cross Release",
      "inherits": "cross-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SUPERBUILD_PRESET": "cross-release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "cross-debug",
      "configurePreset": "cross-debug"
    },
    {
      "name": "cross-release",
      "configurePreset": "cross-release"
    }
  ]
}
